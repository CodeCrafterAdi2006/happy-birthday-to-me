{
  "entities": {
    "Wish": {
      "title": "Wish",
      "description": "A birthday wish left by a friend or family member for Aditya",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the person leaving the wish"
        },
        "message": {
          "type": "string",
          "description": "The birthday message or wish"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the wish was created"
        }
      },
      "required": ["name", "message", "createdAt"]
    }
  },
  "firestore": {
    "/wishes/{wishId}": {
      "schema": "Wish",
      "description": "Wishes submitted for Aditya's 20th birthday"
    }
  }
}
